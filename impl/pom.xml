<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mootmaker</groupId>
  <artifactId>mootmaker-api</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>3.10.2</spotless.version>
    <!-- Pinned, not 'latest'. The VS Code extension is pinned to this same number in
         java.format.settings.google.version; if the two drift, the editor reformats what the build
         then rejects. Bumping means bumping both. -->
    <google-java-format.version>1.30.0</google-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.1.0</checkstyle.version>
    <awssdk.version>2.46.7</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.12.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.amazonaws</groupId>
      <artifactId>aws-lambda-java-core</artifactId>
      <version>1.4.0</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <exclusions>
        <!--
          Both are alternative HTTP client implementations dynamodb pulls in transitively -
          apache5-client is a sync alternative to url-connection-client below (and, left on the
          classpath, the SDK's default resolution silently prefers it over url-connection-client,
          which is not what this project wants), netty-nio-client is an async client this project
          never uses (only the sync DynamoDbClient appears anywhere in impl/src). Excluding both
          cuts ~6.6 MB of unused classes from the shaded jar.
        -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- UpdatePersonHandler and PostConfirmationCreatePersonHandler call AdminUpdateUserAttributes
         directly (see Identity/cognito.tf) - same exclusion reasoning as dynamodb above. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cognitoidentityprovider</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <!-- Runtime hooks (beforeCheckpoint/afterRestore) for Lambda SnapStart - see
         DynamoDbClientProvider's afterRestore priming call. -->
    <dependency>
      <groupId>org.crac</groupId>
      <artifactId>crac</artifactId>
      <version>1.5.0</version>
    </dependency>
    <!--
      The AWS SDK pulls in slf4j-api transitively (via sdk-core) with no binding on the classpath,
      which prints "Failed to load class StaticLoggerBinder" at cold start. Declaring slf4j-api
      directly pins the whole build to one (current) version instead of the SDK's older transitive
      one. slf4j-simple supplies the actual binding - logback-classic did the same job at ~930 KB
      (its file rotation, async appenders, and layout engine are all wasted here: Lambda captures
      stdout/stderr into CloudWatch Logs directly, there's no file to rotate), vs. slf4j-simple's
      ~15 KB. See simplelogger.properties for the format configuration replacing logback.xml.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.18</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>mootmaker-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <!-- Merges META-INF/services/org.slf4j.spi.SLF4JServiceProvider correctly into the
                   shaded jar instead of one dependency's copy silently overwriting another's. -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Formatting is google-java-format in unmodified Google style. `mvn spotless:apply` fixes a
           file; `mvn spotless:check` is what CI runs. reflowLongStrings makes this byte-identical to
           the formatter's command line, which is what the VS Code extension runs - without it the
           editor wraps long string literals and this build does not, and the two fight on save. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>

      <!-- Google's own ruleset, used as shipped. Deviations live in config/checkstyle-suppressions.xml
           so they stay readable in one place rather than as edits to a 108-module file.
           violationSeverity=warning matters: google_checks.xml reports at warning severity, and the
           plugin's default only fails on errors - left alone it prints thousands of findings and
           still says BUILD SUCCESS. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>/google_checks.xml</configLocation>
          <suppressionsLocation>${project.basedir}/../config/checkstyle-suppressions.xml</suppressionsLocation>
          <suppressionsFileExpression>org.checkstyle.google.suppressionfilter.config</suppressionsFileExpression>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
          <consoleOutput>true</consoleOutput>
          <linkXRef>false</linkXRef>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
