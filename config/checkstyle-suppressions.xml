<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  Deviations from Google's checks, kept HERE rather than by editing google_checks.xml.

  google_checks.xml is used exactly as Checkstyle ships it. Every exception this project takes is
  in this file, so "what do we differ from Google on?" has one short answer that can be read in a
  diff, instead of being buried in a 108-module fork nobody will re-compare when Google updates it.

  The javadoc rules below are switched off by a deliberate decision: this codebase explains itself
  in prose comments where the reasoning is non-obvious, and does not want a javadoc block on every
  accessor. Requiring one produces filler that says what the signature already said.
-->
<suppressions>
  <!-- Do not require a javadoc block on every method or type. -->
  <suppress checks="MissingJavadocMethod" files="."/>
  <suppress checks="MissingJavadocType" files="."/>

  <!-- SummaryJavadoc demands a complete sentence as the first line of any javadoc that IS written.
       Dropped with the two above: a comment worth writing is not always worth a formal summary. -->
  <suppress checks="SummaryJavadoc" files="."/>
</suppressions>
